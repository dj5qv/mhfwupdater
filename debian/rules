#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# Builds with the cargo found in PATH: Debian's (trixie and newer) or rustup's.
# Cargo.lock pins the crate versions. Crates missing from ~/.cargo are
# downloaded from crates.io, so the build needs network access unless they
# are already there.
# A separate target directory keeps the build away from target/ of the
# development tree.
export CARGO_TARGET_DIR = $(CURDIR)/debian/cargo-target
# Debug info for the -dbgsym package, dh_strip removes it from the binary.
export CARGO_PROFILE_RELEASE_DEBUG = true

CARGO_VERSION := $(shell sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n 1)
PARALLEL := $(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))
CARGO_FLAGS = --release --locked $(if $(PARALLEL),--jobs $(PARALLEL))

%:
	dh $@

override_dh_auto_configure:
	@if [ "$(CARGO_VERSION)" != "$(DEB_VERSION_UPSTREAM)" ]; then \
		echo "Cargo.toml has version $(CARGO_VERSION)," \
			"debian/changelog $(DEB_VERSION_UPSTREAM)" >&2; \
		exit 1; \
	fi

override_dh_auto_build:
	cargo build $(CARGO_FLAGS)

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	cargo test $(CARGO_FLAGS)
endif

override_dh_auto_install:
	install -D -m 0755 $(CARGO_TARGET_DIR)/release/mhfwupdater \
		debian/mhfwupdater/usr/bin/mhfwupdater

override_dh_auto_clean:
	rm -rf $(CARGO_TARGET_DIR)
